# Local runtime state, never shipped.

# Pre-0.6 builds wrote the preference beside the package; 0.6+ uses the DSH home.
config.json

# Test scratch files
.smoke-*

# Tooling noise
node_modules/
*.log
.DS_Store

# Build artefacts and one-off working files.
#
# The tarball belongs on the GitHub Release, not in the tree: a copy here goes
# stale the moment the next version is packed, and it doubles the clone size.
# The submission scratch folder is generated by scripts/awesome-entry.mjs and
# is meant to be read, not committed.
*.tgz
_awesome-submit/
_preview-*.html
